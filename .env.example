CHAT_API_KEY=your_deepseek_api_key
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash

EMBEDDING_API_KEY=your_zhipu_api_key
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3

CHROMA_PERSIST_DIR=data/chroma
UPLOAD_DIR=data/uploads
SAMPLE_DOCS_DIR=data/sample_docs

# 检索相似度阈值（1/(1+Chroma距离) 换算得分，默认 0.35 ≈ 距离 1.86）
# 注意：旧示例曾写 0.52，与代码默认不一致，已统一为 0.35
SIMILARITY_THRESHOLD=0.35
OFFLINE_SIMILARITY_THRESHOLD=0.18
OFFLINE_FALLBACK_ENABLED=true
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=4

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=industrial_rag
